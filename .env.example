# Local MLX server
MLX_MODEL_PATH="./models"
MLX_SERVER_HOST="127.0.0.1"
MLX_SERVER_PORT=8000
MLX_MAX_KV_SIZE=4096

# Optional runtime tuning
MLX_SERVER_DTYPE="float16"

# Security Configuration
# Network binding - set to true to allow network access (default: false = localhost only)
ALLOW_NETWORK_BINDING=false

# Authorized model directories (colon-separated for multiple dirs, e.g., "./models:/path/to/other/models")
AUTHORIZED_MODEL_DIRS="./models"

# Redact sensitive variables from logs and error messages
REDACT_SENSITIVE_VARS=true

# Disable non-essential endpoints for hardened deployment
DISABLE_HEALTH_ENDPOINT=false
DISABLE_METRICS_ENDPOINT=false
DISABLE_MODELS_ENDPOINT=false
